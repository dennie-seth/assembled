# Linux-native repo. Normalize everything to LF; never let CRLF slip in.
* text=auto eol=lf

# Godot
*.gd     text eol=lf
*.tscn   text eol=lf
*.tres   text eol=lf
*.godot  text eol=lf
*.cfg    text eol=lf
# C / C++
*.c      text eol=lf
*.h      text eol=lf
*.cpp    text eol=lf
*.hpp    text eol=lf
*.cc     text eol=lf
*.cxx    text eol=lf
# JS / web
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.ts     text eol=lf
*.json   text eol=lf
# Docs
*.md     text eol=lf
# Common binaries — never diff/normalize
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.wav    binary
*.mp3    binary
*.ogg    binary
*.flac   binary
# Git LFS — audio finals are large regardless of art direction, so LFS from day one.
assets/final/audio/** filter=lfs diff=lfs merge=lfs -text

# Git LFS — trained model weights (e.g. T-0072's SDXL LoRA) exceed GitHub's
# 100MB per-blob limit. Scoped to assets/final/ so ordinary source/config
# (training_config.toml, corpus.json, etc.) never gets swept into LFS.
assets/final/lora/*.safetensors filter=lfs diff=lfs merge=lfs -text
assets/final/**/*.ckpt filter=lfs diff=lfs merge=lfs -text
assets/final/**/*.pt filter=lfs diff=lfs merge=lfs -text

# develop's committed blob for this file has 2 stray NUL bytes baked into a
# string literal (pre-existing, unrelated to any single branch) that trip
# git's NUL-byte binary-diff heuristic on either side of a comparison. Force
# text diffing so PRs render a real patch instead of "Binary files differ".
# Safe to remove once develop's copy of the file no longer contains NULs.
tools/board/src/runner/promptBuilder.js diff

# T-0464: this file is a generated snapshot (exportApprovalLedger.js), regenerated on every
# reviewer PASS and on a 4h schedule -- both sides of nearly every merge touch it, so the default
# text merge conflicts on it constantly. Route it through a custom merge driver that re-derives the
# merged content (union of card ids, never-older generated_at) instead. The driver's command lives
# in local git config, installed by tools/board/ops/install-approval-ledger-merge-driver.sh (a
# .gitattributes entry can only name a driver, not define one) -- see
# docs/approval-ledger-merge-driver.md. This does not disturb the `*.json text eol=lf` rule above;
# it only adds the `merge` attribute, which is independent of `text`/`eol`.
tools/board/approval-ledger.json merge=approval-ledger
