{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default build (Debug)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release build (T-0171: verify debugGrant absent)",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "db",
      "configurePreset": "default",
      "displayName": "Run all tests against local dev Postgres",
      "description": "Requires docker compose postgres on 127.0.0.1:5433. Start with: docker compose up -d",
      "environment": {
        "DATABASE_URL": "postgresql://assembled:assembled@127.0.0.1:5433/assembled_dev"
      }
    }
  ]
}
