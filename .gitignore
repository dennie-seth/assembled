# Godot
.godot/
*.import
.import/
export_presets.cfg
*.translation
android/

# CI-owned, not a personal dev artifact (T-0030/T-0033) — see docs/ci-notes.md
!/.github/ci-spike/godot-client/export_presets.cfg
# Same exception for the real client (T-0060) — see docs/ci-notes.md
!/client/export_presets.cfg

# GDExtension build output (client/bin) and the vendored godot-cpp build
client/bin/
client/godot-cpp/bin/
.sconsign.dblite

# ci-client.yml's import/smoke/export step logs (local repro artifacts,
# CI keeps its own via the Actions log — not source)
client/import.log
client/smoke.log
client/export.log

# C++
build/
cmake-build-*/
*.o
*.os
*.obj
*.so
*.dll
*.dylib
*.exe
*.a
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json

# Node
node_modules/
dist/
.vite/
coverage/
npm-debug.log*

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Board tool runtime state (not source)
tasks/.id-allocator.json

# Assets (generated, reproducible from assets/src/). "assets/out/" alone
# anchors to the repo root (a mid-pattern slash anchors in gitignore), so
# it misses assets/out/ nested under a tool package (e.g.
# tools/comfy-client/assets/out/, tools/asset-gate test scratch). "**/"
# matches at any depth, root included.
**/assets/out/

# Env / secrets
.env
.env.*
!.env.example

# OS junk
.DS_Store
Thumbs.db
desktop.ini
