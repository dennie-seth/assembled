# Godot
.godot/
*.import
.import/
export_presets.cfg
*.translation
android/

# CI-owned, not a personal dev artifact (T-0030/T-0033) — see docs/ci-notes.md
!/.github/ci-spike/godot-client/export_presets.cfg
# Same exception for the real client (T-0060) — see docs/ci-notes.md
!/client/export_presets.cfg

# GDExtension build output (client/bin) and the vendored godot-cpp build
client/bin/
client/godot-cpp/bin/
.sconsign.dblite

# libcurl vendor build cache (T-0062): downloaded tarball, extracted source,
# and the cmake install tree are all reproducible — only curl.version is source.
client/vendor/curl-*/
client/vendor/*.tar.gz
client/vendor/curl/
# One-off verify debug helpers, not part of the project.
client/vendor_clean.py
_attach_deliverables.mjs
_attach_deliverables.py
commit_msg.txt
run_clang_format.sh
run_clang_format.py
run_fmt.sh
fmt.py
server/run_tests.sh

# ci-client.yml's import/smoke/export step logs (local repro artifacts,
# CI keeps its own via the Actions log — not source)
client/import.log
client/smoke.log
client/export.log

# C++
build/
# CMake out-of-source build dirs anywhere in the tree (e.g. server/build2/,
# a second local build dir alongside server/build/) — "build/" above only
# matches a dir literally named "build", not variants like "build2".
build*/
build2/
build_verify/
cmake-build-*/
*.o
*.os
*.obj
*.so
*.dll
*.dylib
*.exe
*.a
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
