{
  "name": "assembled-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/server/index.js",
    "dev:client": "vite",
    "test": "vitest run",
    "build": "vite build",
    "lint": "eslint .",
    "validate:backlog": "node scripts/validateBacklog.js",
    "check:planner-diff-guard": "node scripts/checkPlannerDiffGuard.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "busboy": "^1.6.0",
    "chokidar": "^3.6.0",
    "file-type": "^21.3.4",
    "js-yaml": "^4.1.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "happy-dom": "^20.11.1",
    "prettier": "^3.3.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
